generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int             @id @default(autoincrement())
  first_name         String?         @map("first_name")
  last_name          String?         @map("last_name")
  email              String          @unique
  password           String
  phone              String?
  address            String?
  role               Int
  status             String?
  last_login         DateTime?       @map("last_login")
  join_date          DateTime?       @map("join_date")
  gender             String?
  birthday           DateTime?
  position           String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  avatar_url         String?         @map("avatar_url")
  cartItems          CartItem[]
  supportAssignments Conversation[]  @relation("SupportAssignedStaff")
  conversations      Conversation[]
  inquiries          Inquiry[]
  notifications      Notification[]
  orders             Order[]
  staffRoles         UserStaffRole[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  body      String
  type      String
  link      String?
  metadata  Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Conversation {
  id              Int                @id @default(autoincrement())
  userId          Int                @map("user_id")
  status          ConversationStatus @default(OPEN)
  assignedStaffId Int?               @map("assigned_staff_id")
  lastMessageAt   DateTime           @default(now()) @map("last_message_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  assignedStaff   User?              @relation("SupportAssignedStaff", fields: [assignedStaffId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
  messages        Message[]

  @@index([userId])
  @@index([status])
  @@index([assignedStaffId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderId       Int          @map("sender_id")
  senderRole     String       @map("sender_role")
  body           String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model UserStaffRole {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  role         StaffRole
  assignedBy   Int?      @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model ArchivedUser {
  id          Int       @id @default(autoincrement())
  user_id     Int?      @map("user_id")
  first_name  String?   @map("first_name")
  last_name   String?   @map("last_name")
  phone       String?
  address     String?
  email       String
  password    String
  role        Int?
  status      String?
  last_login  DateTime?
  join_date   DateTime?
  gender      String?
  birthday    DateTime?
  position    String?
  archived_at DateTime?
}

model Product {
  id                    Int         @id @default(autoincrement())
  name                  String
  sku                   String?     @unique
  description           String?
  price                 Decimal     @db.Decimal(12, 2)
  currency              String      @default("PHP")
  stock                 Int         @default(0)
  width_mm              Int?
  height_mm             Int?
  depth_mm              Int?
  material              String?
  colorOptions          String[]    @default([])
  print_type            String?
  turnaround_hours      Int?
  images                String[]    @default([])
  active                Boolean     @default(true)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deleted_at            DateTime?   @map("deleted_at")
  color_options         String[]    @default([])
  delivery_options      String[]    @default([])
  finishing_options     String[]    @default([])
  material_options      String[]    @default([])
  processing_options    String[]    @default([])
  side_options          String[]    @default([])
  size_options          String[]    @default([])
  quantity_options      String[]    @default([])
  shipping_options      String[]    @default([])
  ai_prompt_rules       String?
  quantity_count        Int?
  quantity_mode         String?
  category              String?     @default("other")
  print_zones           String[]    @default([])
  inkColorChannel       String?     @map("ink_color_channel")
  inkUsagePerUnit       Float?      @map("ink_usage_per_unit")
  substrateMaterialName String?     @map("substrate_material_name")
  substrateUsagePerUnit Float?      @map("substrate_usage_per_unit")
  referenceHeightInches Float?      @map("reference_height_inches")
  referenceWidthInches  Float?      @map("reference_width_inches")
  mockupViews           Json?       @map("mockup_views")
  unitMaterialName      String?     @map("unit_material_name")
  unitUsagePerUnit      Int?        @map("unit_usage_per_unit")
  bleedInches           Float?      @map("bleed_inches")
  safeMarginInches      Float?      @map("safe_margin_inches")
  cartItems             CartItem[]
  orderItems            OrderItem[]
}

model InventorySubstrate {
  id              Int      @id @default(autoincrement())
  materialName    String   @unique @map("material_name")
  stockMeters     Float    @map("stock_meters")
  safetyThreshold Float    @default(15.0) @map("safety_threshold")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([materialName])
}

model InventoryInk {
  id              Int      @id @default(autoincrement())
  colorChannel    String   @unique @map("color_channel")
  volumeMl        Float    @map("volume_ml")
  safetyThreshold Float    @default(15.0) @map("safety_threshold")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([colorChannel])
}

model InventoryUnit {
  id              Int      @id @default(autoincrement())
  itemName        String   @unique @map("item_name")
  stockUnits      Int      @map("stock_units")
  safetyThreshold Int      @default(15) @map("safety_threshold")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([itemName])
}

model PurchaseRequisition {
  id                 Int               @id @default(autoincrement())
  materialType       String            @map("material_type")
  materialName       String            @map("material_name")
  currentStock       Float             @map("current_stock")
  safetyThreshold    Float             @map("safety_threshold")
  requestedAmount    Float             @map("requested_amount")
  status             RequisitionStatus @default(PENDING)
  triggeredByOrderId Int?              @map("triggered_by_order_id")
  documentText       String
  generatedBy        Int?              @map("generated_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  resolvedAt         DateTime?         @map("resolved_at")

  @@index([status])
  @@index([materialName])
}

model Order {
  id                   Int              @id @default(autoincrement())
  userId               Int?
  total                Decimal          @db.Decimal(14, 2)
  currency             String           @default("PHP")
  status               String           @default("pending")
  shipping_address     String?
  billing_address      String?
  proofApproved        Boolean          @default(false)
  due_date             DateTime?
  delivered_at         DateTime?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deleted_at           DateTime?        @map("deleted_at")
  payment_status       String           @default("unpaid")
  checkout_url         String?
  payment_method       String?
  payment_reference    String?
  paymongo_session_id  String?
  baseColorHex         String?          @map("base_color_hex")
  mockupImageUrl       String?          @map("mockup_image_url")
  printHeightInches    Float?           @map("print_height_inches")
  printWidthInches     Float?           @map("print_width_inches")
  productionStatus     ProductionStatus @default(PENDING_FILE_CHECK) @map("production_status")
  amountPaid           Decimal          @default(0) @map("amount_paid") @db.Decimal(14, 2)
  isBulkOrder          Boolean          @default(false) @map("is_bulk_order")
  pendingPaymentAmount Decimal?         @map("pending_payment_amount") @db.Decimal(14, 2)
  branchId             Int?
  designReviewNotes    String?          @map("design_review_notes")
  designReviewStatus   String?          @default("submitted") @map("design_review_status")
  designReviewedAt     DateTime?        @map("design_reviewed_at")
  designReviewedBy     Int?             @map("design_reviewed_by")
  branch               Branch?          @relation(fields: [branchId], references: [id])
  user                 User?            @relation(fields: [userId], references: [id])
  items                OrderItem[]

  @@index([productionStatus])
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int      @default(1)
  unit_price     Decimal  @db.Decimal(14, 2)
  total_price    Decimal  @db.Decimal(14, 2)
  customizations Json?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
}

model CartItem {
  id             Int      @id @default(autoincrement())
  userId         Int
  productId      Int?
  title          String
  price          Decimal  @db.Decimal(14, 2)
  qty            Int      @default(1)
  productImage   String?
  customizations Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  product        Product? @relation(fields: [productId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model Inquiry {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  product_title String?
  subject       String
  name          String
  email         String
  quantity      String?
  size          String?
  color         String?
  material      String?
  finishing     String?
  printing      String?
  processing    String?
  delivery      String?
  other         String?
  status        String   @default("new")
  quoted_price  Decimal? @db.Decimal(14, 2)
  admin_notes   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  order_id      Int?
  design_data   Json?
  isRushOrder   Boolean  @default(false)
  rushOrderFee  Decimal? @db.Decimal(14, 2)
  sizeSurcharge Decimal? @db.Decimal(14, 2)
  user          User?    @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  userName    String?  @map("user_name")
  userEmail   String?  @map("user_email")
  userRole    String?  @map("user_role")
  action      String
  module      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@index([module])
}

model DesignTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  category     String
  thumbnailUrl String?  @map("thumbnail_url")
  zoneLayers   Json     @map("zone_layers")
  baseColor    String?  @map("base_color")
  createdBy    Int?     @map("created_by")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([active])
}

enum StaffRole {
  DESIGN_APPROVER
  PRINT_TECHNICIAN
  QUALITY_ASSURANCE_INSPECTOR
  LOGISTICS_PACKER
  INVENTORY_CONTROLLER
  PROCUREMENT_OFFICER
  PAYMENT_VERIFIER
  CUSTOMER_SUPPORT
}

enum ProductionStatus {
  PENDING_FILE_CHECK
  PRINTING_QUEUE
  QUALITY_ASSURANCE
  PACKAGING_READY
  COMPLETED
  AWAITING_PAYMENT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum RequisitionStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}
