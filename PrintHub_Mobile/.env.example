# Expo requires the EXPO_PUBLIC_ prefix for variables to be available on the client side.

# For Android Studio Emulator, use 10.0.2.2 instead of localhost or 127.0.0.1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
EXPO_PUBLIC_WEB_APP_URL=http://10.0.2.2:3001

# For iOS Simulator or physical devices on the same Wi-Fi, use your local IP (e.g., http://192.168.1.5:3000)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:3000
# EXPO_PUBLIC_WEB_APP_URL=http://192.168.1.X:3001
